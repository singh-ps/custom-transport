{
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "[csharp]": {
        "files.eol": "\r\n"
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "files.exclude": {
        "**/.DS_Store": true,
        "**/*.meta": true,
        "Library/": true,
        "Temp/": true,
        "Logs/": true,
        "obj/": true,
        "UserSettings/": true
    },
    "search.exclude": {
        "Library/": true,
        "Temp/": true,
        "Logs/": true,
        "obj/": true
    }
}
